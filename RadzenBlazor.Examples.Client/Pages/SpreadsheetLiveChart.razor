@page "/spreadsheet-live-chart"

<PageTitle>Spreadsheet-driven chart - Radzen Blazor Examples</PageTitle>

<RadzenStack Gap="1.5rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Spreadsheet-driven chart</RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-secondary">
            The <code>RadzenSpreadsheet</code> holds the data; an external dual-axis <code>RadzenChart</code>
            reads the cells and redraws as you edit. Because it's a real chart (not the in-sheet one), the
            <strong>right axis gets its own scale</strong>.
        </RadzenText>
    </RadzenStack>

    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                Edit the <strong>Left</strong> (B) or <strong>Right</strong> (C) columns — the chart updates when you leave an edited cell or add a row.
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem" Wrap="FlexWrap.Wrap">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenLabel Text="Data points" Component="points" />
                    <RadzenNumeric TValue="int" Name="points" @bind-Value="@points" @bind-Value:after="Rebuild"
                                   Min="3" Max="12" Step="1" Style="width: 6rem;" />
                </RadzenStack>
                <RadzenButton Text="Randomize data" Icon="casino" ButtonStyle="ButtonStyle.Secondary"
                              Variant="Variant.Flat" Size="ButtonSize.Small" Click="@Randomize" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-p-0" Style="overflow: hidden;">
        @if (RendererInfo.IsInteractive)
        {
            <RadzenSpreadsheet @key="workbookVersion" Workbook="@workbook" WorkbookChanged="@OnWorkbookChanged"
                               ExportFileName="trace-data"
                               ShowToolbar="true" ShowFormulaBar="true" ShowSheetTabs="true"
                               Style="height: 360px;" />
        }
        else
        {
            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 360px;">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">Loading spreadsheet…</RadzenText>
            </RadzenStack>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined">
        <DualAxisChart @ref="chartCmp" LeftData="@leftPoints" RightData="@rightPoints"
                       LeftTitle="Left" RightTitle="Right" ShowRightGrid="false" Height="420px" />
    </RadzenCard>
</RadzenStack>

@code {
    private int points = 6;
    private int seed = 1;
    private int workbookVersion;
    private string signature = "";

    private Workbook workbook = new();
    private List<DualAxisChart.AxisPoint> leftPoints = new();
    private List<DualAxisChart.AxisPoint> rightPoints = new();

    private DualAxisChart? chartCmp;

    // Safety cap so a stray far-down cell can't make the read scan run away.
    private const int MaxDataRows = 200;

    protected override void OnInitialized()
    {
        workbook = BuildWorkbook();
        ReadFromSheet(force: true);
    }

    // Fired when the spreadsheet commits an edit (cell blur/Enter) or a row is inserted/deleted.
    // The signature guard inside ReadFromSheet makes this a no-op when nothing actually changed,
    // so re-rendering with the component's own workbook can't cause a refresh loop.
    private async Task OnWorkbookChanged(Workbook wb)
    {
        workbook = wb;
        if (ReadFromSheet(force: false))
        {
            StateHasChanged();
            if (chartCmp is not null)
                await chartCmp.ReloadAsync();
        }
    }

    private void Randomize()
    {
        seed++;
        Rebuild();
    }

    private void Rebuild()
    {
        points = Math.Clamp(points, 3, 12);
        workbookVersion++;
        workbook = BuildWorkbook();
        signature = "";
        ReadFromSheet(force: true);
    }

    private Workbook BuildWorkbook()
    {
        var wb = new Workbook();
        var rowCount = Math.Max(points + 2, 12);
        var sheet = wb.AddSheet("Traces", rowCount, 6);

        sheet.Cells["A1"].Value = "Point";
        sheet.Cells["B1"].Value = "Left";
        sheet.Cells["C1"].Value = "Right";

        // Disparate scales (Left ~hundreds, Right ~thousands) so the value of an independent
        // right axis is obvious. Deterministic per seed for flicker-free prerender → WASM.
        var rng = new Random(seed);
        for (var i = 0; i < points; i++)
        {
            var row = i + 2;
            sheet.Cells[$"A{row}"].Value = $"P{i + 1}";
            sheet.Cells[$"B{row}"].Value = (double)rng.Next(100, 501);
            sheet.Cells[$"C{row}"].Value = (double)rng.Next(2000, 9001);
        }

        return wb;
    }

    // Read the two trace columns out of the sheet. Returns true when the data changed since last read.
    private bool ReadFromSheet(bool force)
    {
        var sheet = workbook.GetSheet("Traces");
        if (sheet is null)
            return false;

        var left = new List<DualAxisChart.AxisPoint>();
        var right = new List<DualAxisChart.AxisPoint>();
        var parts = new List<string>();

        // Scan every data row (not a fixed count) so rows added via the sheet show up and
        // deleted rows drop off. A fully-empty row (A, B and C blank) marks the end of the data.
        // Cap at the sheet's allocated RowCount — Cells[$"A{row}"] throws past the last row.
        var lastRow = Math.Min(MaxDataRows + 1, sheet.RowCount);
        for (var row = 2; row <= lastRow; row++)
        {
            var categoryRaw = sheet.Cells[$"A{row}"].GetValue();
            var bRaw = sheet.Cells[$"B{row}"].GetValue();
            var cRaw = sheet.Cells[$"C{row}"].GetValue();

            if (string.IsNullOrEmpty(categoryRaw) && string.IsNullOrEmpty(bRaw) && string.IsNullOrEmpty(cRaw))
                break;

            var category = string.IsNullOrEmpty(categoryRaw) ? $"P{row - 1}" : categoryRaw;
            var l = ReadNumber(sheet.Cells[$"B{row}"]);
            var r = ReadNumber(sheet.Cells[$"C{row}"]);

            left.Add(new DualAxisChart.AxisPoint(category, l));
            right.Add(new DualAxisChart.AxisPoint(category, r));
            parts.Add($"{category}|{l}|{r}");
        }

        var sig = string.Join(";", parts);
        if (!force && sig == signature)
            return false;

        signature = sig;
        leftPoints = left;
        rightPoints = right;
        return true;
    }

    private static double ReadNumber(Cell cell)
    {
        if (cell.Value is IConvertible convertible)
        {
            try { return Convert.ToDouble(convertible); }
            catch { /* fall through to string parse */ }
        }
        return double.TryParse(cell.GetValue(), out var value) ? value : 0;
    }
}
